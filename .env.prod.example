# Copy to .env.prod on the server and fill in. Use letters and digits only in DB_PASSWORD.
# DOMAIN: your Elastic IP with dashes + .sslip.io, e.g. IP 13.233.1.2 -> 13-233-1-2.sslip.io
DOMAIN=13-233-1-2.sslip.io
DB_PASSWORD=change-me-letters-and-digits-only
SECRET_KEY=change-me-long-random-string
# 1 = load demo users/data on start (safe to repeat). Set to 0 once loaded.
SEED_ON_START=1
