FROM python:3.12-slim

# WeasyPrint (invoice / report PDFs) needs these native libraries.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libharfbuzz-subset0 \
    libjpeg62-turbo \
    libopenjp2-7 \
    libffi8 \
    fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONUNBUFFERED=1 DJANGO_SETTINGS_MODULE=config.settings.production

COPY requirements/ requirements/
RUN pip install --no-cache-dir -r requirements/prod.txt

COPY . .
RUN SECRET_KEY=build-only-secret-key-with-at-least-32-chars \
    ALLOWED_HOSTS=localhost \
    DATABASE_URL=postgresql://build:build@localhost:5432/build \
    python manage.py collectstatic --noinput

# 1) apply migrations  2) optionally seed demo data (idempotent)  3) start API
CMD ["sh", "-c", "python manage.py migrate --noinput && if [ \"$SEED_ON_START\" = \"1\" ]; then ENABLE_BENCHMARK_TOOLS=true python manage.py seed_benchmark; fi && exec gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 1 --threads 4 --timeout 120"]
