# ---------------------------------------------------------------------------
# Development (docker-compose.yml / local Vite)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://kadai:kadai_dev@db:5432/kadai
SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Production (docker-compose.prod.yml)
#
# SECRET_KEY must be unique and at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API container refuses to start without SECRET_KEY, ALLOWED_HOSTS and
# DATABASE_URL. Never reuse the development values above.
# ---------------------------------------------------------------------------
POSTGRES_DB=kadai
POSTGRES_USER=kadai
POSTGRES_PASSWORD=replace-with-a-long-random-password

ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=

# Set these once TLS terminates in front of the web service.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

WEB_PORT=80
GUNICORN_WORKERS=3
SESSION_COOKIE_AGE=43200
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_MAX_FAILED_ATTEMPTS_PER_IP=20
LOG_LEVEL=INFO
